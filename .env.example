# Telegram notifications for the contact form.
# Copy this file to .env.local (gitignored) and fill in the values.
# For Vercel, add the same vars under Project -> Settings -> Environment Variables.

# 1) Message @BotFather on Telegram -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=

# 2) Open a chat with your new bot and send it any message, then run:
#    curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
#    Copy result[0].message.chat.id
TELEGRAM_CHAT_ID=
